{
  "name": "country-is",
  "description": "A lightweight TypeScript wrapper for the Country.is API with first-class support for Node.js and modern browsers. API Source: https://country.is/",
  "keywords": [
    "country",
    "country-is",
    "geolocation",
    "ip-lookup",
    "ip-geolocation",
    "location",
    "geoip",
    "api-wrapper",
    "typescript",
    "node",
    "browser",
    "fetch",
    "location-info",
    "ip-info",
    "rest-api"
  ],
  "license": "MIT",
  "version": "0.5.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf -v ./dist && rm -rf -v ./coverage",
    "prepublishOnly": "npm run build",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --watch",
    "test:coverage": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --coverage --verbose"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "msw": "^2.15.0",
    "ts-jest": "^29.4.6",
    "typescript": "^5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NPM-Workbench/country-is.git"
  },
  "bugs": {
    "url": "https://github.com/NPM-Workbench/country-is/issues"
  },
  "homepage": "https://github.com/NPM-Workbench/country-is"
}
